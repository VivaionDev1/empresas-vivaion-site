NODE_ENV=development
HOST=127.0.0.1
PORT=8082
APP_ORIGIN=http://localhost:4321
# Crie um usuario e banco exclusivos. Nao utilize bancos UNYOM ou Area do Aluno.
DATABASE_URL=postgresql://vivaion_empresas_dev:SUBSTITUA_ESTA_SENHA@127.0.0.1:5432/vivaion_empresas_dev
CATALOG_FEED_URL=https://vivaion.com.br/integracoes/empresas/catalogo/v1.json
ALLOW_LOCAL_CATALOG_FEED=false
# Permanecer false ate politica de precos aprovada e testes concluídos.
CORPORATE_PRICING_ENABLED=false

# Transactional email uses an operator-provisioned HTTPS relay, never browser APIs.
# POST JSON { from, to, subject, text, category } + Authorization Bearer token.
# Registration and password recovery return 503 until mail delivery is configured.
MAIL_RELAY_URL=
MAIL_RELAY_BEARER_TOKEN=
MAIL_FROM=
