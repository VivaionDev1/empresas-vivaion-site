{
  "name": "@vivaion/empresas-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "test:integration": "node --import tsx --test test/integration/*.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "catalog:sync": "tsx scripts/sync-catalog.ts",
    "start": "node dist/src/server.js"
  },
  "dependencies": {
    "@vivaion/empresas-contracts": "0.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.1.3",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3"
  }
}
