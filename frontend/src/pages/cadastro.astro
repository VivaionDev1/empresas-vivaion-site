---
import SiteLayout from "../layouts/SiteLayout.astro";
const isLive = import.meta.env.PUBLIC_SITE_LIVE === "true";
const authEnabled = isLive || import.meta.env.PUBLIC_AUTH_ENABLED === "true";
const emailActionsEnabled = isLive || import.meta.env.PUBLIC_EMAIL_ACTIONS_ENABLED === "true";
---
<SiteLayout title="Criar conta empresarial" description="Comece o cadastro da sua empresa na Vivaion. A representação e o CNPJ são verificados antes da liberação de benefícios." noindex>
  <section class="section"><div class="container auth-layout">
    <div class="auth-aside"><span class="eyebrow">Bem-vindo à Vivaion Empresas</span><h2>Um novo espaço para investir em pessoas.</h2><p>Crie uma conta vinculada à sua empresa. A verificação do CNPJ e a confirmação da representação são necessárias antes de qualquer benefício ou contratação corporativa.</p><div class="auth-benefits"><span>Catálogo de cursos em um só lugar</span><span>Propostas corporativas sob avaliação</span><span>Gestão futura de vagas e matrículas</span></div></div>
    <div class="form-panel"><h2>Cadastro empresarial</h2><p>{emailActionsEnabled ? "Preencha os dados abaixo para iniciar o processo de análise." : "O cadastro abrirá quando o envio seguro de confirmação por e-mail estiver configurado."}</p>
      {emailActionsEnabled ? <form id="register-form" class="form-grid">
        <label class="field field--wide">Razão social<input name="companyName" required minlength="3" maxlength="180" autocomplete="organization" /></label>
        <label class="field field--wide">CNPJ<input name="cnpj" required minlength="14" maxlength="22" placeholder="Aceita CNPJ numérico ou alfanumérico" autocapitalize="characters" /></label>
        <label class="field field--wide">Nome do representante<input name="fullName" required minlength="3" maxlength="140" autocomplete="name" /></label>
        <label class="field field--wide">E-mail corporativo<input name="email" type="email" required maxlength="254" autocomplete="email" /></label>
        <label class="field">Senha<input name="password" type="password" required minlength="15" maxlength="128" autocomplete="new-password" aria-describedby="password-hint" /><small id="password-hint">Use pelo menos 15 caracteres; uma frase longa é mais fácil de lembrar.</small></label>
        <label class="field">Confirmar senha<input name="confirmation" type="password" required minlength="15" maxlength="128" autocomplete="new-password" /></label>
        <label class="field field--wide" style="display:flex;align-items:start;gap:11px;font-weight:400"><input name="accepted" type="checkbox" required style="width:auto;min-height:auto;margin-top:6px" /><span>Solicito o cadastro em nome da organização informada e estou ciente de que será necessária confirmação dos dados e da representação.</span></label>
        <label class="field field--wide" style="display:flex;align-items:start;gap:11px;font-weight:400"><input name="privacyAcknowledged" type="checkbox" required style="width:auto;min-height:auto;margin-top:6px" /><span>Li o <a class="inline-link" href="/privacidade/" target="_blank" rel="noopener noreferrer">aviso de privacidade</a> e estou ciente das finalidades do cadastro.</span></label>
        <div class="form-feedback" id="register-feedback" role="status" aria-live="polite"></div>
        <div class="form-submit"><span style="font-size:.78rem;color:var(--muted)">Já possui conta? <a href="/entrar/" class="inline-link">Entrar</a></span><button class="button button--primary" type="submit">Solicitar cadastro <span aria-hidden="true">→</span></button></div>
      </form> : <div class="notice notice--info"><p>{authEnabled ? "O portal exige confirmação do e-mail. O cadastro está temporariamente fechado até o canal seguro de envio ser configurado." : "Esta prévia não recebe CNPJ, dados pessoais ou senhas. Fale com a equipe para tirar dúvidas sobre capacitação corporativa."}</p><a class="button button--primary" href="https://wa.me/554588042562?text=Ol%C3%A1%2C%20quero%20conversar%20sobre%20capacita%C3%A7%C3%A3o%20para%20minha%20empresa." target="_blank" rel="noopener noreferrer">Conversar com a equipe →</a></div>}
    </div>
  </div></section>
</SiteLayout>
<script>
  const form = document.querySelector<HTMLFormElement>("#register-form");
  const feedback = document.querySelector<HTMLElement>("#register-feedback");
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form || !feedback) return;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const data = new FormData(form);
    if (data.get("password") !== data.get("confirmation")) {
      feedback.textContent = "As senhas não conferem.";
      feedback.dataset.state = "error";
      return;
    }
    submit && (submit.disabled = true);
    feedback.textContent = "Enviando cadastro…";
    feedback.dataset.state = "info";
    try {
      const result = await fetch("/api/auth/register", {
        method: "POST", credentials: "same-origin", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          companyName: data.get("companyName"), cnpj: data.get("cnpj"),
          fullName: data.get("fullName"), email: data.get("email"), password: data.get("password")
        })
      });
      const payload = await result.json().catch(() => ({}));
      if (!result.ok) throw new Error(payload.message ?? "Não foi possível enviar o cadastro.");
      feedback.textContent = payload.message ?? "Cadastro registrado. Confirme o seu e-mail antes de entrar.";
      feedback.dataset.state = "success";
      form.reset();
    } catch (error) {
      feedback.textContent = error instanceof Error ? error.message : "Falha de comunicação. Tente novamente.";
      feedback.dataset.state = "error";
    } finally { submit && (submit.disabled = false); }
  });
</script>
