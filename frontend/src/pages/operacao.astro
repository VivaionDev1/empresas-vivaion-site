---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout title="Operação comercial" description="Área restrita de atendimento empresarial Vivaion." noindex>
  <section class="page-hero"><div class="container"><span class="eyebrow eyebrow--light">Acesso institucional restrito</span><h1>Operação comercial.</h1><p>Solicitações, atribuições e acompanhamento de propostas, somente para equipe autorizada.</p></div></section>
  <section class="section"><div class="container" style="max-width:1120px">
    <div class="notice notice--info" id="staff-notice" role="status" aria-live="polite">Verificando acesso ao painel...</div>
    <div class="form-panel" id="staff-login" hidden style="max-width:540px;margin-top:24px">
      <h2>Entrar no atendimento</h2>
      <p>Somente e-mails previamente autorizados recebem acesso. O link expira em 15 minutos.</p>
      <form id="staff-access-form" class="form-grid">
        <label class="field field--wide">E-mail institucional<input type="email" name="email" required autocomplete="email" maxlength="254"/></label>
        <div class="form-submit"><button type="submit" class="button button--primary">Solicitar link de acesso</button></div>
      </form>
    </div>
    <div id="staff-panel" hidden>
      <div class="dashboard-panel" style="margin:24px 0">
        <div style="display:flex;gap:16px;justify-content:space-between;flex-wrap:wrap;align-items:center">
          <div><span class="eyebrow">Atendimento interno</span><h2 id="staff-greeting">Equipe</h2></div>
          <button type="button" id="staff-logout" class="button button--outline">Encerrar sessão</button>
        </div>
        <div id="staff-overview" class="dashboard-stats" aria-live="polite"></div>
        <p class="section-intro">O alerta de 48 horas é indicativo até a equipe aprovar um SLA oficial.</p>
        <p id="staff-notification-health" class="section-intro" role="status" hidden></p>
      </div>
      <div class="dashboard-panel" style="margin-bottom:24px">
        <h2>Solicitações recebidas</h2>
        <label class="field">Filtrar por situação
          <select id="staff-filter">
            <option value="">Todas</option><option value="received">Recebidas</option>
            <option value="assigned">Atribuídas</option><option value="contacted">Contatadas</option>
            <option value="proposal_sent">Proposta enviada</option><option value="negotiating">Em negociação</option>
            <option value="won">Concluídas</option><option value="lost">Não convertidas</option>
            <option value="closed">Arquivadas</option>
          </select>
        </label>
        <button type="button" id="staff-reload" class="button button--outline">Atualizar lista</button>
        <div id="staff-leads" aria-live="polite" style="margin-top:18px"></div><button type="button" id="staff-more" class="button button--outline" style="margin-top:15px" hidden>Carregar mais solicitações</button>
      </div>
      <section id="staff-detail" class="dashboard-panel" hidden>
        <h2>Detalhes e atendimento</h2>
        <div id="staff-detail-data"></div>
        <form id="staff-change-form" class="form-grid">
          <label class="field">Etapa do atendimento
            <select name="status" id="staff-new-status">
              <option value="">Manter etapa atual</option><option value="assigned">Atribuída</option>
              <option value="contacted">Contatada</option><option value="proposal_sent">Proposta enviada</option>
              <option value="negotiating">Em negociação</option><option value="won">Concluída</option>
              <option value="lost">Não convertida</option><option value="closed">Arquivada</option>
            </select>
          </label>
          <label class="field" id="staff-assignee-label" hidden>Responsável
            <select id="staff-assignee" name="assignedStaffId"><option value="">Sem atribuição</option></select>
          </label>
          <label class="field field--wide">Motivo e registro da ação
            <textarea name="reason" required minlength="10" maxlength="1000" placeholder="Descreva a ação ou contato realizado. Evite informações pessoais desnecessárias."></textarea>
          </label>
          <div class="form-submit"><button type="submit" class="button button--primary">Salvar acompanhamento</button></div>
        </form>
        <h3>Histórico de ações</h3><div id="staff-events"></div>
      </section>
    </div>
  </div></section>
</SiteLayout>
<script>
type Staff={id:string;fullName:string;role:"manager"|"sales"};
type Lead={id:string;company_name:string;contact_name:string;contact_email:string;contact_phone:string|null;status:string;assigned_staff_id:string|null;assigned_staff_name?:string|null;created_at:string;courses?:number;items?:Array<{title:string;quantity:number}>;message?:string|null};
const notice=document.querySelector<HTMLElement>("#staff-notice")!;
const panel=document.querySelector<HTMLElement>("#staff-panel")!;
const login=document.querySelector<HTMLElement>("#staff-login")!;
const list=document.querySelector<HTMLElement>("#staff-leads")!;
const more=document.querySelector<HTMLButtonElement>("#staff-more")!;
let nextCursor:string|null=null;
const detail=document.querySelector<HTMLElement>("#staff-detail")!;
let staff:Staff|null=null;
let selected:Lead|null=null;
let team:Array<{id:string;full_name:string;role:string}>=[];
const labels:Record<string,string>={received:"Recebida",assigned:"Atribuída",contacted:"Contatada",proposal_sent:"Proposta enviada",negotiating:"Em negociação",won:"Concluída",lost:"Não convertida",closed:"Arquivada"};
function message(value:string,error=false){notice.textContent=value;notice.dataset.state=error?"error":"info";}
async function api(path:string,options:RequestInit={}){
  const response=await fetch("/api/staff"+path,{credentials:"same-origin",cache:"no-store",...options});
  const data=await response.json().catch(()=>({}));
  if(!response.ok)throw Error(data.error??"Falha na solicitação");
  return data;
}
const text=(tag:string,value:unknown)=>{
  const el=document.createElement(tag);el.textContent=String(value??"—");return el;
};
function formatDate(s:string){return new Intl.DateTimeFormat("pt-BR",{dateStyle:"short",timeStyle:"short"}).format(new Date(s));}
function addRow(parent:Element,label:string,value:unknown){
  const p=document.createElement("p");const b=document.createElement("strong");b.textContent=label+": ";p.append(b,document.createTextNode(String(value??"—")));parent.append(p);
}
async function reload(append=false){
  const filter=(document.querySelector<HTMLSelectElement>("#staff-filter")!).value;
  if(!append){list.replaceChildren();nextCursor=null;}
  const query=new URLSearchParams();
  if(filter)query.set("status",filter);
  if(append&&nextCursor)query.set("cursor",nextCursor);
  const data=await api("/leads"+(query.size?"?"+query.toString():""));
  if(!data.leads.length&&!append){list.textContent="Não há solicitações para este filtro.";}
  nextCursor=typeof data.nextCursor==="string"?data.nextCursor:null;
  more.hidden=!nextCursor;
  for(const lead of data.leads as Lead[]){
    const row=document.createElement("div");row.style.cssText="padding:14px 0;border-bottom:1px solid var(--line);display:flex;flex-wrap:wrap;gap:14px;justify-content:space-between;align-items:center";
    const info=document.createElement("div");
    info.append(text("strong",lead.company_name),text("p",labels[lead.status]??lead.status));
    info.append(text("small",formatDate(lead.created_at)+" · "+(lead.courses??0)+" curso(s) · "+(lead.assigned_staff_name??"Sem responsável")));
    const b=document.createElement("button");b.type="button";b.className="button button--outline";b.textContent="Examinar";b.addEventListener("click",()=>openLead(lead.id));
    row.append(info,b);list.append(row);
  }
}
async function overview(){
  const data=await api("/overview");
  const el=document.querySelector<HTMLElement>("#staff-overview")!;el.replaceChildren();
  for(const item of data.statuses as Array<{status:string;total:number}>){
    const cell=document.createElement("div");cell.className="dashboard-stat";cell.append(text("strong",item.total),text("small",labels[item.status]??item.status));el.append(cell);
  }
  if(data.overdue)message(data.overdue+" solicitação(ões) em aberto há mais de 48 horas.");
}
async function openLead(id:string){
  const data=await api("/leads/"+encodeURIComponent(id));selected=data.lead;
  detail.hidden=false;
  const info=document.querySelector<HTMLElement>("#staff-detail-data")!;info.replaceChildren();
  addRow(info,"Empresa",selected!.company_name);addRow(info,"Nome",selected!.contact_name);
  addRow(info,"E-mail",selected!.contact_email);addRow(info,"Telefone",selected!.contact_phone);
  addRow(info,"Etapa",labels[selected!.status]??selected!.status);
  addRow(info,"Mensagem",selected!.message);
  const h=text("h3","Formações solicitadas");info.append(h);
  const ul=document.createElement("ul");for(const item of selected!.items??[])ul.append(text("li",item.title+" — "+item.quantity+" vaga(s)"));info.append(ul);
  const events=document.querySelector<HTMLElement>("#staff-events")!;events.replaceChildren();
  for(const e of data.events as Array<{event_type:string;created_at:string;metadata?:{from?:string;to?:string;reason?:string}}>){
    const line=document.createElement("p");line.append(text("strong",formatDate(e.created_at)+" · "+e.event_type));
    if(e.metadata?.to)line.append(text("span"," · "+e.metadata.from+" → "+e.metadata.to));
    if(e.metadata?.reason)line.append(text("span"," · "+e.metadata.reason));
    events.append(line);
  }
  const assignee=document.querySelector<HTMLSelectElement>("#staff-assignee")!;
  assignee.value=selected!.assigned_staff_id??"";
  document.querySelector<HTMLSelectElement>("#staff-new-status")!.value="";
  detail.scrollIntoView({behavior:"smooth",block:"start"});
}
async function load(){
  try{
    const auth=await api("/me");staff=auth.staff;login.hidden=true;panel.hidden=false;
    document.querySelector<HTMLElement>("#staff-greeting")!.textContent="Olá, "+staff!.fullName;
    if(staff!.role==="manager"){
      const response=await api("/team");team=response.staff;
      const select=document.querySelector<HTMLSelectElement>("#staff-assignee")!;
      for(const person of team){const opt=document.createElement("option");opt.value=person.id;opt.textContent=person.full_name;select.append(opt);}
      document.querySelector<HTMLElement>("#staff-assignee-label")!.hidden=false;
      try{
        const health=await api("/notifications/status");
        const line=document.querySelector<HTMLElement>("#staff-notification-health")!;
        line.textContent="Notificações: "+health.counts.pending+" pendentes; "+health.counts.dead+" com falha definitiva. "+
          (health.deliveryEnabled?"Entrega autorizada no ambiente.":"Entrega automática ainda desativada.");
        line.hidden=false;
      }catch{/* status is advisory, not required to view leads */}
    }
    await Promise.all([overview(),reload()]);
    message("Acesso restrito autenticado. Não compartilhe dados de solicitações fora dos canais autorizados.");
  }catch{panel.hidden=true;login.hidden=false;message("Informe seu e-mail institucional para solicitar acesso.");}
}
document.querySelector<HTMLFormElement>("#staff-access-form")!.addEventListener("submit",async e=>{
  e.preventDefault();const fd=new FormData(e.currentTarget as HTMLFormElement);
  try{const response=await api("/request-access",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({email:fd.get("email")})});message(response.message);}
  catch(err){message(err instanceof Error?err.message:"Falha no pedido",true);}
});
document.querySelector<HTMLFormElement>("#staff-change-form")!.addEventListener("submit",async e=>{
  e.preventDefault();if(!selected)return;
  const form=e.currentTarget as HTMLFormElement;
  const fd=new FormData(form);
  const status=fd.get("status");const assignee=fd.get("assignedStaffId");
  const body:Record<string,unknown>={reason:fd.get("reason")};
  if(status)body.status=status;
  if(staff?.role==="manager"&&assignee!==selected.assigned_staff_id)body.assignedStaffId=assignee||null;
  try{
    await api("/leads/"+selected.id,{method:"PATCH",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)});
    message("Atualização registrada com auditoria.");form.reset();
    await Promise.all([openLead(selected.id),reload(),overview()]);
  }catch(err){message(err instanceof Error?err.message:"Falha ao salvar",true);}
});
document.querySelector<HTMLButtonElement>("#staff-logout")!.addEventListener("click",async()=>{
  await api("/logout",{method:"POST"}).catch(()=>{});
  location.assign("/operacao/");
});
document.querySelector<HTMLButtonElement>("#staff-reload")!.addEventListener("click",()=>reload().catch(()=>message("Falha ao atualizar",true)));
more.addEventListener("click",()=>reload(true).catch(()=>message("Falha ao carregar mais solicitações",true)));
document.querySelector<HTMLSelectElement>("#staff-filter")!.addEventListener("change",()=>reload().catch(()=>message("Falha ao filtrar",true)));
(async()=>{
  const token=new URLSearchParams(location.hash.slice(1)).get("token") ?? new URLSearchParams(location.search).get("token");
  if(token){
    history.replaceState(null,"",location.pathname);
    try{await api("/verify-access",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({token})});}
    catch{message("Link inválido ou expirado. Solicite um novo acesso.",true);}
  }
  await load();
})();
</script>